+    def _init_claude(self) -> None:
+        """Claude models run through `claude -p` (Claude Code CLI) with the user's subscription login.
+
+        No API key is used: ANTHROPIC_API_KEY is removed from the child environment, since with a key
+        set the CLI would bill the API instead of the subscription. The CLI runs in an empty directory
+        so no project files, CLAUDE.md or memory are read, with its own system prompt replaced by the
+        configured one, no tools, and no MCP servers. Temperature and top_p cannot be set. Each call's
+        token usage is appended to claude_usage.jsonl in the current directory.
+        """
+        import shutil
+
+        if shutil.which("claude") is None:
+            raise RuntimeError("the 'claude' command (Claude Code) is not on PATH")
+        if os.getenv("ANTHROPIC_API_KEY"):
+            logger.warning("ANTHROPIC_API_KEY is set; it is ignored for Claude calls (subscription login is used)")
+        self._claude_cwd = tempfile.mkdtemp(prefix="claude_cwd_")
+        self._claude_usage_log = Path("claude_usage.jsonl").resolve()
+        logger.info("Using Claude Code CLI model: %s (subscription, no API key)", self.model_cfg.name)
+
+    def _generate_claude(
+        self, prompt: str, decoding_cfg: DecodingCfg, chat_cfg: ChatCfg
+    ) -> Tuple[str, float]:
+        cmd = [
+            "claude", "-p", "--model", self.model_cfg.name,
+            "--system-prompt", chat_cfg.system_prompt,
+            "--tools", "", "--strict-mcp-config", "--disable-slash-commands",
+            "--no-session-persistence", "--setting-sources", "", "--output-format", "json",
+        ]
+        env = {k: v for k, v in os.environ.items() if k not in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")}
+        waited = 0
+        while True:
+            proc = subprocess.run(
+                cmd, input=prompt, capture_output=True, text=True, cwd=self._claude_cwd, env=env, timeout=3600
+            )
+            try:
+                out = json.loads(proc.stdout)
+            except json.JSONDecodeError:
+                raise RuntimeError(f"claude CLI failed (rc={proc.returncode}): {proc.stderr[:300] or proc.stdout[:300]}")
+            message = str(out.get("result"))
+            if out.get("is_error") and "limit" in message.lower() and waited < 12 * 3600:
+                # plan usage limit reached: wait for the window to reset instead of failing the paper
+                logger.warning("Claude usage limit reached (%s); waiting 15 minutes", message[:120])
+                time.sleep(900)
+                waited += 900
+                continue
+            break
+        if out.get("is_error"):
+            raise RuntimeError(f"claude CLI error: {message[:300]}")
+        served = set(out.get("modelUsage", {}))
+        if served != {self.model_cfg.name}:
+            # the CLI can silently answer an unavailable model name with another model
+            raise RuntimeError(f"requested {self.model_cfg.name} but the CLI used {sorted(served)}")
+        if out.get("stop_reason") == "max_tokens":
+            raise ValueError("Response was truncated at the CLI's output limit")
+        usage = out.get("usage", {})
+        with open(self._claude_usage_log, "a") as f:
+            f.write(json.dumps({
+                "model": self.model_cfg.name,
+                "input_tokens": usage.get("input_tokens"),
+                "cache_creation_input_tokens": usage.get("cache_creation_input_tokens"),
+                "cache_read_input_tokens": usage.get("cache_read_input_tokens"),
+                "output_tokens": usage.get("output_tokens"),
+                "thinking_tokens": (usage.get("output_tokens_details") or {}).get("thinking_tokens"),
+                "api_equivalent_usd": out.get("total_cost_usd"),
+                "duration_ms": out.get("duration_ms"),
+            }) + "\n")
+        # subscription use: nothing is billed, so the estimated cost stays 0 (see claude_usage.jsonl)
+        return (out.get("result") or "").strip(), 0.0
